# BẮT BUỘC - dùng đúng cùng giá trị với bản Production
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
FLASK_SECRET_KEY=replace-with-at-least-64-random-hex-characters

# BẮT BUỘC trên Vercel Production/Preview. App sẽ dừng nếu thiếu FLASK_SECRET_KEY.
APP_ENV=production

# CHẾ ĐỘ TEST AN TOÀN — chỉ bật khi SUPABASE_URL trỏ sang project Supabase TEST riêng
# APP_ENV=test
# PES_ARENA_TEST_MODE=true
# DATABASE_SAFETY_TOKEN=PES_ARENA_TEST_DATABASE

# Tên tương thích cũ, không cần tạo nếu đã có các biến chính ở trên:
# SUPABASE_KEY=your-service-role-key
# SECRET_KEY=change-this-to-a-long-random-secret

# Chỉ cho phép mật khẩu 1 ký tự khi Test Mode đã được xác nhận an toàn ở trên.
# Tuyệt đối không bật trên Production.
# ALLOW_SIMPLE_TEST_PASSWORDS=true

# URL public của thư mục ảnh tối ưu chung trên Supabase Storage.
# Bản Clean đã bỏ ảnh local: bắt buộc khai báo URL Supabase trên Vercel.
# Ví dụ: https://PROJECT.supabase.co/storage/v1/object/public/pes-assets/v1.14.41
STATIC_ASSET_BASE_URL=

# URL public riêng cho ảnh Shop. Không bắt buộc; đã có default Supabase đã kiểm chứng.
SHOP_ASSET_BASE_URL=

# Lucky Box assets (Supabase Storage public folder)
LUCKYBOX_ASSET_BASE_URL=

# Room/Mode cũng có default public Supabase; chỉ dùng các biến sau nếu cần override.
ROOM_ASSET_BASE_URL=
MODE_ASSET_BASE_URL=
